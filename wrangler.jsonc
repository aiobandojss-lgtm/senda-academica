{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senda",
  // Cuenta de Cloudflare de Senda (Sendafundacion@outlook.com's Account). El login de Wrangler es uno solo para todo el
  // equipo: si alguien entra con otra cuenta (pasó el 2026-11-18), cualquier comando falla con un error de autenticación
  // en lugar de usar la cuenta equivocada; un `wrangler deploy` no podría publicar `senda` en otra cuenta. No es un
  // secreto. En el CI manda la variable CLOUDFLARE_ACCOUNT_ID, que debe tener este mismo valor.
  "account_id": "65a11d0b8bbe0d6fb9eb63ec7b92f876",
  // Punto de entrada del Worker: la API con Hono
  "main": "./api/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Cron Trigger diario a las 08:00 UTC (3:00 a. m. de Colombia): depura las conversaciones del asistente de más
  // de 30 días (RAG design.md D10). El plan Free permite 5 por cuenta
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "upload_source_maps": true,
  "assets": {
    // Con el plugin de Vite el directorio real lo define el build (dist/client)
    "directory": "./dist/client",
    // Una ruta del frontend que no es un archivo (p. ej. /estudiante/notas) devuelve index.html
    // y React decide qué pantalla mostrar
    "not_found_handling": "single-page-application",
    // Solo /api/* ejecuta el Worker; lo demás se sirve directo como archivo estático
    "run_worker_first": ["/api/*"]
  },
  // Configuración no secreta (design.md D19). Los secretos, como JWT_SECRET, nunca van aquí:
  // en local se ponen en .dev.vars y en Cloudflare con `wrangler secret put`
  "vars": {
    "PRODUCTO_NOMBRE": "Senda",
    // Se cambia por el nombre real solo cuando la Fundación lo autorice por escrito
    "FUNDACION_NOMBRE": "Fundación (demo)",
    // Texto provisional: el canal de contacto definitivo lo confirma la Fundación
    "CONTACTO_FUNDACION": "la coordinación administrativa de la Fundación",
    // Debe coincidir con la versión del aviso que acepta el seed (db/seed/generar-seed.mjs)
    "AVISO_PRIVACIDAD_VERSION": "2026-11",
    // "kv" mientras la cuenta no tenga medio de pago; "r2" en producción (ADR-002)
    "ALMACEN_ARCHIVOS": "kv",
    // Modelos de Workers AI del asistente (RAG design.md D2), verificados en el catálogo el 2026-11-17 (tarea 1.1).
    // Si cambia el de embeddings, hay que recrear el índice Vectorize (1024 dimensiones) y reindexar los documentos.
    "MODELO_EMBEDDINGS": "@cf/baai/bge-m3",
    // Provisional: la evaluación (tarea 4.1) lo compara con @cf/meta/llama-3.3-70b-instruct-fp8-fast y deja aquí el ganador
    "MODELO_CHAT": "@cf/openai/gpt-oss-20b",
    // Espacio (namespace) de Vectorize de este entorno (RAG design.md D2). `npm run dev` usa el índice real, el mismo de
    // producción: vite.config.ts lo cambia a "local" solo en desarrollo para que las pruebas locales no toquen la demo
    "RAG_ESPACIO": "produccion"
  },
  // Workers AI no tiene simulador local: cada llamada va a Cloudflare y gasta la cuota gratuita (10.000 neuronas
  // diarias), incluso en `npm run dev`. Las pruebas de Vitest y el E2E corren sin bindings remotos y no lo llaman.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Índice vectorial de los documentos del asistente (RAG design.md D2): 1024 dimensiones y coseno, con índices de
  // metadatos carrera_id (número) y tipo (texto). Los índices de metadatos se crean ANTES de cargar vectores: los
  // vectores cargados antes no quedan filtrables. Tampoco tiene simulador local: `npm run dev` usa el índice real.
  "vectorize": [
    {
      "binding": "VECTORES",
      "index_name": "fundacion-docs",
      "remote": true
    }
  ],
  // Secretos que el Worker necesita (solo los nombres; los valores nunca van en el repositorio).
  // - `wrangler deploy` falla si alguno no está cargado en Cloudflare: mejor que publicar un login roto.
  // - `wrangler types` los toma de aquí y no de .dev.vars, así los tipos son iguales en local y en el CI.
  // - JWT_SECRET firma las sesiones (design.md D4). En local va en .dev.vars (ver .dev.vars.example).
  "secrets": {
    "required": ["JWT_SECRET"]
  },
  // Los IDs no son secretos: sin la sesión de Wrangler o un API token no dan acceso.
  // En local, Wrangler usa una copia de cada recurso en .wrangler/state
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "senda-db",
      // Creada con --location enam (este de Norteamérica, la región de D1 más cercana a Colombia)
      "database_id": "20de6070-4de5-459f-9934-e2e93c3d5c66",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // Archivos de entregas y soportes (design.md D7); en el dashboard se llama "senda-archivos"
      "binding": "ARCHIVOS_KV",
      "id": "fffe717334a74c03b571b45145a8f5e8"
    }
  ]
}
