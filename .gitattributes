# Finales de línea: LF en el repositorio y en la copia de trabajo (el CI corre en Linux)
* text=auto eol=lf

# Scripts propios de Windows conservan CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios: Git nunca los convierte
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.docx  binary
*.xlsx  binary
